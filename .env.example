# OpenAI (required for default generation path)
OPENAI_API_KEY=sk-your-key-here

# Optional: local corpus override
# LEGAL_DATA_DIR=./data/swiss_legal

# Optional: load corpus from S3 instead of (or in addition to) local files
# AWS_S3_DATA_BUCKET=your-bucket
# AWS_S3_DATA_PREFIX=swiss_legal/
# AWS_REGION=eu-central-1

# Optional: webhook auth for async job callbacks
# LEGAL_PREDICTION_CALLBACK_SECRET=change-me

# Optional: filter public-authority party cases from retrieval (default: true)
# LEGAL_FILTER_PUBLIC_AUTHORITY_PARTIES=true

# API
# PORT=3001
